# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluxapay?schema=public"

# Security & Authentication
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
API_KEY_HEADER="x-api-key"

# CORS Configuration (comma-separated origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://fluxapay.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stellar Blockchain Rails
STELLAR_NETWORK="TESTNET"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
STELLAR_HOT_WALLET_PUBLIC=""

# Webhooks & Signatures
WEBHOOK_SIGNING_SECRET="whsec_sample_secret_key_for_fluxapay_signature"
WEBHOOK_TIMEOUT_MS=5000
